  "author": "Idir Yacine",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build && cp build/client/index.html build/client/404.html",
    "dev": "node ./scripts/dev.cjs && remix vite:dev",
    "start": "vite preview --outDir build/client --port 7777",
    "postinstall": "node ./scripts/draco.cjs",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
